{
  "name": "asistencias",
  "version": "2.0.0",
  "description": "Gestión académica INGEMAT: asistencia, simulacros por áreas, lectura OMR y notificaciones oficiales",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "migrate": "node src/database/migrador.js",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "omr:doctor": "node scripts/check-omr.cjs",
    "test:omr": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "check": "node scripts/check-syntax.cjs",
    "test:ui": "playwright test",
    "format": "prettier --write app.js src Public/js/admin/v2.js Public/js/session.js Public/css/v2.css Public/pages/v2-panel.html tests scripts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "better-sqlite3": "^13.0.3",
    "bootstrap-icons": "^1.13.2",
    "csv-parse": "^7.0.3",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonardoAliaga/asistencias-ingemat.git"
  },
  "bugs": {
    "url": "https://github.com/LeonardoAliaga/asistencias-ingemat/issues"
  },
  "homepage": "https://github.com/LeonardoAliaga/asistencias-ingemat#readme",
  "engines": {
    "node": ">=24.0.0 <25 || >=26.0.0 <27"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10"
  }
}
