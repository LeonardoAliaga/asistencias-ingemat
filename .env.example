# Copy to .env. Never commit the real file.
PORT=3001
APP_TIMEZONE=America/Lima
NODE_ENV=development
# For an existing installation, keep its data and Registros folders or point to their absolute paths.
# DATA_DIR=C:/Academia/ingemat-data
# RECORDS_DIR=C:/Academia/Registros
# Set before the first v2 start; minimum 12 characters. Remove after the first login.
# ADMIN_INITIAL_PASSWORD=
# A random persistent secret is generated in data/session-secret.key when omitted.
# SESSION_SECRET=
# Set only behind a trusted reverse proxy that terminates HTTPS.
# TRUST_PROXY=1
# APP_URL=https://academia.example
# Windows: C:/Academia/.venv/Scripts/python.exe
# Linux: /opt/ingemat/.venv/bin/python
# PYTHON_BIN=python3
# Diagnose the effective Python and OMR dependencies: npm run omr:doctor

# Optional: NAPS2.Console.exe is detected in standard Windows installation folders.
# NAPS2_BIN=C:/Program Files/NAPS2/NAPS2.Console.exe
# Diagnose scanner discovery: npm run scanner:doctor -- wia

# Official WhatsApp Cloud API: Meta may charge per delivered message.
# Check current pricing before enabling. Notifications stay OFF until configured in the dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
